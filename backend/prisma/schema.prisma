// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum Role {
  USER
  ADMIN
}

enum PictureRarity {
  NORMAL // 普通
  PREMIUM // 高級
}

// 會員
model Member {
  member_id     Int        @id @default(autoincrement())
  email         String     @unique // 電子郵件
  password      String // 密碼
  name          String // 姓名
  birthday      DateTime? // 生日
  gender        String? // 性別
  phone         String? // 電話
  bio           String?    @db.Text // 自介
  blood_type    String? // 血型
  constellation String? // 星座
  role          Role       @default(USER)
  created_at    DateTime   @default(now()) // 註冊時間
  logins_failed Int        @default(0) // 登入失敗次數
  locked_time   DateTime? // 鎖定時間，?=null，表示未鎖定
  status        UserStatus @default(ACTIVE) // 帳號狀態

  bottles          Bottle[]
  BlacklistedToken BlacklistedToken[]
  bottleLikes      BottleLike[]
  bottleSaves      BottleSave[]
  Comment          Comment[]
  report           BottleReport[]
  gameRecords      GameRecord[]
  commentLikes     CommentLike[]
  DaliyNote        DaliyNote[]

  following    Follow[]        @relation("UserFollows") // 這個會員追蹤了哪些人 (我追蹤的人)
  followers    Follow[]        @relation("UserFollowedBy") // 哪些人追蹤了這個會員 (我的粉絲)
  PollVote     PollVote[]
  Notification Notification[]
  Pet          Pet?
  pictures     MemberPicture[]

  // 拼圖碎片與寶箱庫存
  normal_fragments  Int @default(0) // 普通碎片數量 (可累積兌換)
  premium_fragments Int @default(0) // 高級碎片數量 (可累積兌換)
  normal_chests     Int @default(0) // 普通寶箱數量
  premium_chests    Int @default(0) // 高級寶箱數量
}

model BlacklistedToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique @db.Text
  member_id  Int // 外鍵：指向會員
  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [member_id])
}

// 忘記密碼
model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime // 過期時間
  createdAt DateTime @default(now())

  @@index([email])
}

// 漂流瓶
model Bottle {
  bottle_id        Int      @id @default(autoincrement())
  member_id        Int // 外鍵：指向發表者
  is_anonymous     Boolean  @default(false) // 是否匿名
  content          String   @db.Text // 內容
  created_at       DateTime @default(now()) // 發布時間
  title            String // 標題
  view_count       Int      @default(0) // 觀看人數
  status           Int      @default(0) // 審核狀態 (0待審, 1通過, 2違規)
  violation_reason String? // 違規原因

  // 關聯定義
  author     Member           @relation(fields: [member_id], references: [member_id])
  // 關聯：透過「擁有」中間表連接到類別
  categories BottleCategory[]
  likes      BottleLike[]
  saves      BottleSave[]
  Comment    Comment[]
  report     BottleReport[]
  PollOption PollOption[]
  PollVote   PollVote[]
}

// 類別表
model Category {
  category_id Int    @id @default(autoincrement())
  name        String @unique // 類別名稱

  // 關聯
  bottles BottleCategory[]
}

// 「擁有」中間表 M:N 多對多關係
model BottleCategory {
  bottle_id   Int
  category_id Int

  bottle   Bottle   @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)
  category Category @relation(fields: [category_id], references: [category_id], onDelete: Cascade)

  @@id([bottle_id, category_id]) // 複合主鍵，確保同一個瓶子不會重複加入同一個類別
}

model BottleLike {
  id        Int      @id @default(autoincrement())
  member_id Int      @map("member_id")
  bottle_id Int      @map("bottle_id")
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  bottle Bottle @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)

  // 確保同一個使用者對同一篇貼文只能按一次讚
  @@unique([member_id, bottle_id])
}

model BottleSave {
  id        Int      @id @default(autoincrement())
  member_id Int      @map("member_id")
  bottle_id Int      @map("bottle_id")
  createdAt DateTime @default(now()) @map("created_at")

  member Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  bottle Bottle @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)

  // 確保同一個使用者對同一篇貼文只能收藏一次
  @@unique([member_id, bottle_id])
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  member_id Int      @map("member_id")
  bottle_id Int      @map("bottle_id")
  createdAt DateTime @default(now()) @map("created_at")

  is_anonymous Boolean @default(false)

  parent_id Int?   @map("parent_id")
  // 關聯：留言是誰留的、留在哪個瓶子上 (一樣加上 Cascade 級聯刪除，保證資料庫乾淨)
  member    Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  bottle    Bottle @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)

  likes CommentLike[]

  parent  Comment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")
}

model BottleReport {
  id         Int      @id @default(autoincrement())
  member_id  Int // 檢舉人 ID
  bottle_id  Int // 被檢舉的瓶子 ID
  reason     String   @db.Text // 檢舉理由 (例如：血腥暴力、洗頻、惡意攻擊)
  status     Int      @default(0) // 審核狀態 (0:待處理, 1:檢舉成立, 2:檢舉不成立)
  created_at DateTime @default(now()) // 檢舉時間

  // 關聯：誰檢舉的、檢舉哪篇 (加上 Cascade，文章或人被刪時紀錄自動消失)
  reporter Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  bottle   Bottle @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)

  // 🌟 重要防呆：確保同一個使用者對同一篇貼文，只能發送一次檢舉 (防惡意洗版)
  @@unique([member_id, bottle_id])
}

model CommentLike {
  id         Int      @id @default(autoincrement())
  member_id  Int      @map("member_id")
  comment_id Int      @map("comment_id")
  createdAt  DateTime @default(now()) @map("created_at")

  Member  Member?  @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  Comment Comment? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@unique([member_id, comment_id])
}

model GameRecord {
  id             Int      @id @default(autoincrement())
  member_id      Int
  game_name      String
  difficulty     String
  high_score     Int      @default(0)
  last_played_at DateTime @default(now()) @updatedAt

  // 關聯定義
  member Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)

  @@unique([member_id, game_name, difficulty])
}

model DaliyNote {
  id         Int      @id @default(autoincrement())
  member_id  Int
  content    String   @db.VarChar(50)
  date       String
  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)

  @@unique([member_id, date])
}

model Follow {
  follower_id  Int // 追蹤者 (誰發出追蹤)
  following_id Int // 被追蹤者 (誰被追蹤)
  created_at   DateTime @default(now()) // 追蹤時間

  // 關聯定義
  follower  Member @relation("UserFollows", fields: [follower_id], references: [member_id], onDelete: Cascade)
  following Member @relation("UserFollowedBy", fields: [following_id], references: [member_id], onDelete: Cascade)

  // 複合主鍵，確保同一個使用者不會重複追蹤同一個人兩次
  @@id([follower_id, following_id])
}

model PollOption {
  id        Int    @id @default(autoincrement())
  bottle_id Int    @map("bottle_id")
  text      String @db.VarChar(100) // 選項文字 (例如：贊成、反對)

  // 關聯
  bottle Bottle     @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)
  votes  PollVote[]
}

model PollVote {
  id         Int      @id @default(autoincrement())
  member_id  Int      @map("member_id")
  bottle_id  Int      @map("bottle_id")
  option_id  Int      @map("option_id")
  created_at DateTime @default(now())

  // 關聯
  member Member     @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  bottle Bottle     @relation(fields: [bottle_id], references: [bottle_id], onDelete: Cascade)
  option PollOption @relation(fields: [option_id], references: [id], onDelete: Cascade)

  @@unique([member_id, bottle_id])
}

model Notification {
  id         Int      @id @default(autoincrement())
  member_id  Int      @map("member_id")
  actor_id   Int?
  type       String
  content    String   @db.Text
  is_read    Boolean  @default(false)
  target_id  Int?
  created_at DateTime @default(now())

  member Member @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
}

model Pet {
  pet_id             Int      @id @default(autoincrement())
  member_id          Int      @unique
  coin               Int      @default(0)
  pet_name           String   @default("神秘雪兔")
  is_named           Boolean  @default(false)
  pet_color          String   @default("經典雪兔")
  background_color   String   @default("基礎藍")
  background_effects String   @default("none")
  x                  Int      @default(0)
  y                  Int      @default(0)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  last_feed_time   DateTime @default("2000-01-01T00:00:00Z")
  last_purify_time DateTime @default("2000-01-01T00:00:00Z")
  last_pet_time    DateTime @default("2000-01-01T00:00:00Z")

  member       Member         @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  PetInventory PetInventory[]
}

model PetInventory {
  inventory_id Int      @id @default(autoincrement())
  pet_id       Int
  category     String
  item_name    String
  created_at   DateTime @default(now())

  pet Pet @relation(fields: [pet_id], references: [pet_id], onDelete: Cascade)

  @@unique([pet_id, category, item_name])
}

// 圖片拼圖/圖鑑表 (主表：圖片資訊、稀有度、碎片總數)
model Picture {
  id               Int           @id @default(autoincrement())
  title            String // 拼圖名稱 (例如: "小丑魚", "神秘海豚")
  description      String?       @db.Text // 圖片介紹 / 背後故事
  image_url        String        @unique // 圖片完整路徑 (前端以 3x3 網格切九宮格顯示)
  total_pieces     Int           @default(9) // 碎片總數 (預設 9 片，編號 1~9)
  rarity           PictureRarity @default(NORMAL) // 稀有度: NORMAL(普通), PREMIUM(高級)
  category         String?       @default("DEFAULT") // 分類/系列 (例如: "海洋生物")
  task_requirement String? // 任務獲取條件說明
  is_active        Boolean       @default(true) // 是否開放收集
  created_at       DateTime      @default(now())

  // 關聯
  memberPictures MemberPicture[]
}

// 使用者拼圖碎片進度與收集清單
model MemberPicture {
  id              Int       @id @default(autoincrement())
  member_id       Int // 會員 ID
  picture_id      Int // 圖片 ID
  unlocked_pieces Int[]     @default([]) // 已獲得的碎片編號清單 (例如 [1, 3, 7])
  piece_count     Int       @default(0) // 已解鎖碎片數 (0~9)
  is_completed    Boolean   @default(false) // 是否 9 片已全部集齊
  completed_at    DateTime? // 拼圖全部集齊的時間
  obtained_from   String?   @default("TASK") // 獲得管道 (例如: "TASK", "DAILY_SIGNIN")
  obtained_at     DateTime  @default(now()) // 最近獲得碎片時間
  updated_at      DateTime  @default(now()) @updatedAt // 最近獲得碎片時間

  // 關聯定義
  member  Member  @relation(fields: [member_id], references: [member_id], onDelete: Cascade)
  picture Picture @relation(fields: [picture_id], references: [id], onDelete: Cascade)

  // 確保同一位會員對同一張圖片只會有一筆拼圖進度紀錄
  @@unique([member_id, picture_id])
}
